# Environment Variables Example
# Field names only; the application does not automatically load .env.
# Set values in the launch shell; keep credentials local and untracked.

# FinMind API Token
FINMIND_TOKEN=your_token_here

# Optional: Data root directory
# DATA_ROOT=F:/Min/Python/Project/FA_Data

# Optional: Output root directory
# OUTPUT_ROOT=F:/Min/Python/Project/FA_Data/output

# Optional: Profile
# PROFILE=prod
